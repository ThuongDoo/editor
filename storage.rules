rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Images uploaded from the editor's ImageField (see src/lib/storage.js)
    // land under websites/{websiteId}/... — gate writes to that website's
    // owner, same ownership check as firestore.rules' websites/update rule.
    match /websites/{websiteId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && firestore.get(/databases/(default)/documents/websites/$(websiteId)).data.ownerId == request.auth.uid
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
